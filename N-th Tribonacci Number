class Solution:
    def tribonacci(self, n: int) -> int:        
        if n ==0:
            return 0
        if n == 1:
            return 1
        if n == 2:
            return 1
        f = [0,1,1]
        for i in range(3,n+1):
            f.append(f[0]+f[1]+f[2])
            f.pop(0)
        return f[2]

