class Solution:
    def tribonacci(self, n: int) -> int:        
        if n ==0:
            return 0
        if n == 1:
            return 1
        if n == 2:
            return 1
        if n == 3:
            return 2
        else:
            tn = 0
            tn1 = 1
            tn2 = 1
            for _ in range(3,n+1):
                tn3 = tn+tn1+tn2
                tn=tn1
                tn1=tn2
                tn2=tn3
            return tn3
