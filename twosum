class Solution:
    def twoSum(self, nums: List[int], target: int) -> List[int]:
        l = {}
        for i in range(0,len(nums)):
            for j in range(i+1,len(nums)):
                l[nums[i]+nums[j]] = [i,j]
        if target in l:
            return l[target]
        else:
            x = 0
            for key in l.items():
                if x > key or x == 0:
                    x = key
            return(l[x])
